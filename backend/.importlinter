[importlinter]
root_package = app

# Layers are added as each phase creates them. Parenthesised names are
# optional layers (no error while the module does not yet exist).
[importlinter:contract:layers]
name = Mana Career layered architecture
type = layers
layers =
    (app.api)
    (app.worker)
    (app.domain)
    app.infra
    app.core
    app.models

[importlinter:contract:domain-isolation]
name = domain must not import api or worker
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    app.api
    app.worker
