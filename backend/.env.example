# Backend-only template for running the API/worker outside Docker (cwd=backend).
# `just init-env` writes backend/.env from it with a generated JWT_SECRET.
# Production and Compose variables live in the root .env.example.

# ---- Backend ----
ENV=dev
LOG_LEVEL=info
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000
# Peers allowed to report the real client IP via CF-Connecting-IP (a local
# Cloudflare tunnel). Leave blank unless you run a tunnel; see docs/runbook.md.
TRUSTED_PROXY_CIDRS=

DATABASE_URL=postgresql+asyncpg://mana:mana@localhost:5432/mana
DATABASE_URL_TEST=postgresql+asyncpg://mana:mana@localhost:5432/mana_test
REDIS_URL=redis://localhost:6379/0

# Generated by `just init-env` (openssl rand -hex 32). Required; no default.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=mana_refresh
# Must stay true in production (the app refuses false when ENV=prod).
REFRESH_COOKIE_SECURE=true

RATE_LIMIT_DEFAULT_PER_MINUTE=240
UPLOAD_LIMIT_PER_HOUR=20
LLM_LIMIT_PER_HOUR=60
MAX_REQUEST_BODY_BYTES=1048576

# Supported: fake | anthropic. "fake" returns empty model output; the
# deterministic résumé, matching and roadmap logic still works.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Supported: fake | voyage
EMBEDDINGS_PROVIDER=fake
EMBED_MODEL=fake-embed-1
EMBED_DIM=1024

# Supported: none | fake | tavily. "none" switches web research off.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

FILE_STORE=local
FILE_STORE_LOCAL_DIR=./var/files
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=15
# PDF text extractor: pdfium (fast, PDFium engine) | pypdf (pure-Python fallback)
RESUME_PARSER=pdfium
LLM_MODEL_EXTRACTION=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5

# Production refuses fake providers unless this is true. The UI then labels the
# deployment as a demo.
DEMO_MODE=false

# ---- Email (application emails, after you approve them) ----
# console: logs only, nothing leaves the server (default).
# smtp:    real delivery through any SMTP server: a Gmail app password
#          (smtp.gmail.com:587), Brevo, Resend, Postmark, SES, or Mailpit locally
#          (SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURITY=none; UI on :8025).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none (none is refused in production)
SMTP_SECURITY=starttls
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Mana Career
# redirect: every application email goes to the applicant's own inbox, with a
#           note naming the employer address (safe for a public demo).
# live:     it goes to the employer, with a copy to the applicant.
EMAIL_DELIVERY=redirect
EMAIL_DAILY_LIMIT_PER_USER=5
EMAIL_DAILY_LIMIT_TOTAL=100
# Where the web app lives: password-reset and email-confirmation links point
# here. Must be https in production when EMAIL_PROVIDER=smtp.
APP_BASE_URL=http://localhost:3000
