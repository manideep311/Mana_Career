# Mana Career environment template.
#
#   just init-env        # copies this file to .env and generates real secrets
#
# Never deploy with values copied by hand from this file: JWT_SECRET is blank on
# purpose, and the app refuses placeholder or development secrets at startup.

# ---- Backend ----
ENV=dev
LOG_LEVEL=info
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000
# Peers allowed to report the real client IP via CF-Connecting-IP (a local
# Cloudflare tunnel). Leave blank unless you run a tunnel; see docs/runbook.md.
TRUSTED_PROXY_CIDRS=

DATABASE_URL=postgresql+asyncpg://mana:mana@localhost:5432/mana
DATABASE_URL_TEST=postgresql+asyncpg://mana:mana@localhost:5432/mana_test
REDIS_URL=redis://localhost:6379/0
# Small hosts (e.g. Render free + Supabase's session pooler) keep these low.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# Run the background worker inside the API process (hosts without a worker type).
# RUN_WORKER_IN_API=false
# WORKER_MAX_JOBS=10
# Shared with the website's /api proxy on Vercel so the API can trust the
# visitor address it forwards (`openssl rand -hex 32`); see docs/deploy.md.
# PROXY_SHARED_SECRET=

# Generated by `just init-env` (openssl rand -hex 32). Required; no default.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=mana_refresh
# Must stay true in production (the app refuses false when ENV=prod).
REFRESH_COOKIE_SECURE=true

RATE_LIMIT_DEFAULT_PER_MINUTE=240
UPLOAD_LIMIT_PER_HOUR=20
LLM_LIMIT_PER_HOUR=60
MAX_REQUEST_BODY_BYTES=1048576

# Supported: fake | anthropic. "fake" returns empty model output; the
# deterministic résumé, matching and roadmap logic still works.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Supported: fake | voyage
EMBEDDINGS_PROVIDER=fake
EMBED_MODEL=fake-embed-1
EMBED_DIM=1024

# Supported: none | fake | tavily. "none" switches web research off.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# local | supabase (a private Supabase Storage bucket; see docs/deploy.md)
FILE_STORE=local
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=resumes
FILE_STORE_LOCAL_DIR=./var/files
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=15
# PDF text extractor: pdfium (fast, PDFium engine) | pypdf (pure-Python fallback)
RESUME_PARSER=pdfium
LLM_MODEL_EXTRACTION=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_FALLBACK=claude-sonnet-5

# Production refuses fake providers unless this is true. The UI then labels the
# deployment as a demo.
DEMO_MODE=false

# ---- Email (application emails, after you approve them) ----
# console: logs only, nothing leaves the server (default).
# smtp:    real delivery through any SMTP server: a Gmail app password
#          (smtp.gmail.com:587), Brevo, Resend, Postmark, SES, or Mailpit locally
#          (SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURITY=none; UI on :8025).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none (none is refused in production)
SMTP_SECURITY=starttls
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Mana Career
# redirect: every application email goes to the applicant's own inbox, with a
#           note naming the employer address (safe for a public demo).
# live:     it goes to the employer, with a copy to the applicant.
EMAIL_DELIVERY=redirect
EMAIL_DAILY_LIMIT_PER_USER=5
EMAIL_DAILY_LIMIT_TOTAL=100
# Where the web app lives: password-reset and email-confirmation links point
# here, and link previews (LinkedIn, Slack...) load their image from here
# (compose.prod.yml passes it to the frontend build). Must be https in
# production when EMAIL_PROVIDER=smtp.
APP_BASE_URL=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Compose (compose.prod.yml interpolation only; NOT read by app Settings) ----
POSTGRES_USER=mana
# Generated by `just init-env`. compose.prod.yml refuses to start without it.
POSTGRES_PASSWORD=
POSTGRES_DB=mana
TAG=local
PROXY_SUBNET=172.30.0.0/24
# nginx's fixed address must sit outside the dynamic range.
NGINX_PROXY_IP=172.30.0.2
PROXY_DYNAMIC_RANGE=172.30.0.128/25

# ==================== PRODUCTION ====================
# compose.prod.yml always runs the backend with ENV=prod, which requires:
#   JWT_SECRET            >= 32 random characters (init-env generates 64)
#   REFRESH_COOKIE_SECURE true
#   CORS_ORIGINS          explicit origins, no "*"
#   real providers:       LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY,
#                         EMBEDDINGS_PROVIDER=voyage + VOYAGE_API_KEY
#   ...or DEMO_MODE=true to run a clearly labelled demo on the fake providers.
# Web research is optional: SEARCH_PROVIDER=tavily + SEARCH_API_KEY, or none.
# The bundled nginx serves the app and API same-origin, so the frontend needs
# no API base URL. Full procedure: docs/runbook.md
